<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
 <mapper namespace="com.example.demo.emp.mapper.EmployeeMapper">
 	
 	<sql id="criteria">
		<where>
 			<if test = "departmentId != null">
 				and department_id = #{departmentId}
 			</if>
 			<if test = "managerId != null">
 				and manager_id = #{managerId}
 			</if>
	 		<if test = "lastName != null and lastName !=''">
	 			and upper(last_name) like upper('%' || #{lastName} ||'%')
	 		</if>
 		</where>
 	</sql>
 	
 	<select id="selectAll_COUNT" resultType="int">
  		SELECT COUNT(*) FROM employees
  		<include refid="criteria"></include>
	</select>
 	
 	<select id="selectAll"
 			resultType="EmployeeVO">
 		select * 
 		from employees
 		<include refid="criteria"></include>
 	</select>
 	
 	<select id="selectOne">
 		select * 
 		from employees 
 		where employee_id = #{empid}
 	</select>
 	<insert id="insert"
 			parameterType="EmployeeVO">
 		insert into employees (employee_id, last_name, email, hire_date, job_id,salary)
		values(#{employeeId},#{lastName},#{email},#{hireDate},#{jobId},#{salary})
 	</insert>
 	<update id="update">
 		update employees
		set last_name = #{lastName},
		salary = #{salary}
		where employee_id = #{employeeId}
 	</update>
 	<delete id="delete">
 		delete from employees
		where employee_id = #{employeeId}
 	</delete>
 </mapper>