	//등록
		int insert(DepartmentVO emp) {
			int cnt = 0;
			String sql = """
					insert into departments (department_id, department_name,manager_id,location_id)
					values(?,?,?,?,?)
					""";
			try (
	        		//(2. 데이터베이스 연결)
	            Connection conn = DriverManager.getConnection(url, username, password);
	            //SQL 구문
				PreparedStatement stmt = conn.prepareStatement(sql);
	        	) {
				stmt.setInt(1, emp.getDepartmentId());
				stmt.setString(2, emp.getDepartmentName());
				stmt.setInt(3, emp.getManagerId());
				stmt.setInt(4, emp.getLocationId());
				cnt = stmt.executeUpdate();
			}
			catch (Exception e) {
	            e.printStackTrace();
	       }
			return cnt;
		}
		
		//수정
		int update(DepartmentVO emp) {
			int cnt = 0;
			String sql = """
					update departments
					set department_name = ?,
					manager_id = ?
					where department_id = ?
					""";
			try (
	        		//(2. 데이터베이스 연결)
	            Connection conn = DriverManager.getConnection(url, username, password);
	            //SQL 구문
				PreparedStatement stmt = conn.prepareStatement(sql);
	        	) {
				stmt.setString(1, emp.getDepartmentName());
				stmt.setDouble(2, emp.getManagerId());
				stmt.setInt(3, emp.getDepartmentId());
				
				
				cnt = stmt.executeUpdate();
			}
			catch (Exception e) {
	            e.printStackTrace();
	       }
			return cnt;
		}
		
		//삭제
